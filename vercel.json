{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.6.2"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.css)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.gif|.*\\.webp|.*\\.ico|.*\\.svg)",
      "dest": "/$1"
    },
    {
      "src": "/login.php",
      "dest": "/api/login.php"
    },
    {
      "src": "/logout.php",
      "dest": "/api/logout.php"
    },
    {
      "src": "/admin_dashboard.php",
      "dest": "/api/admin_dashboard.php"
    },
    {
      "src": "/admin_projects.php",
      "dest": "/api/admin_projects.php"
    },
    {
      "src": "/admin_settings.php",
      "dest": "/api/admin_settings.php"
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    }
  ]
}
