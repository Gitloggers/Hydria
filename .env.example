# Database Configuration
# For local XAMPP setup:
# DB_HOST=localhost
# DB_NAME=hydria_db
# DB_USER=root
# DB_PASS=
# DB_PORT=3306

DB_HOST=your_db_host
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_PORT=3306

# Secret key used for signing administrative session cookies.
# Keep this secret and make it a long random string.
APP_SECRET=your_app_secret_key_change_me
